{
  "name": "worshipflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Church worship presentation studio: manuscripts (lyrics, hymns, sermons), offline Bible (public-domain KJV/ASV), images and videos with theming and live projection.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "generate:bible-layout": "node scripts/generate-bible-layout.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "fflate": "^0.8.3",
    "firebase": "^12.16.0",
    "framer-motion": "^11.11.17",
    "holy-bible": "^1.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.460.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "workbox-window": "^7.4.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5"
  }
}
