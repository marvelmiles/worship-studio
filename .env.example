# ---------------------------------------------------------------------------
# Stream module — one-tap pairing (optional)
#
# These enable the Stream module's one-tap "phone broadcasts → laptop picks it"
# flow. Firebase is used ONLY as an ephemeral signalling middleman: it relays a
# few hundred bytes of WebRTC handshake text and then the data is deleted. The
# camera video always flows phone → laptop directly over your WiFi and never
# touches Firebase.
#
# Leave these unset and the app still works — the Stream module falls back to
# the offline QR / paste-a-code pairing.
#
# Setup: create a free Firebase project → enable Realtime Database → copy the
# values below from Project settings. Then see STREAM_SIGNALING.md for the
# database rules to paste in.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
